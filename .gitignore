# Gradle
.gradle/
build/
local.properties

# IDE
.idea/
*.iml
captures/

# NDK / native
.externalNativeBuild/
.cxx/

# OS
.DS_Store

# Rust（agate-server 本地构建产物；Cargo.lock 不忽略——CI 生成后提交回库）
agate-server/target/

# 内核 .so 由 build-android-so.sh 现场产出，不入库
core-gateway/src/main/jniLibs/

# MCP 工具本地产物，不入库
.mcp-change-history.json
*.mcp-backup-*

# 协作代理的本地工作记忆（每日进展 / 约定笔记）。仓库是公开的，
# 这些是过程记录不是项目产物，不入库。
.workbuddy/

# 本地取回的 CI 产物（APK），不入库
dist/

# 两份纯本地的过程文档：灵犀移植方案是「做到哪一步」的临时推演记录，
# 控制台预览页是界面草图 —— 两者都随实现反复改、且不对应交付物。
# 2026-11-14 应用户要求从索引里摘出（文件仍留在本地）。
docs/WPS灵犀-移植方案.md
docs/控制台页-重设计预览.html

# 本地同步的上游源码快照（用于比对分析，体积大且不属本项目产物），不入库。
# **前导斜杠不能省**：写成 `upstream/` 会匹配任意层级的同名目录，把内核的
# `agate-server/src/server/core/upstream/`（转发链源码）一起吃掉 —— 已跟踪的
# 文件照旧能改，但**新增**文件从此静默不入库，本地编译一切正常、CI 却报
# 「file not found for module」。2026-11-05 就是这么让 `image_compress.rs`
# 在 CI 上凭空消失的。
/upstream/

# JVM 崩溃现场（Kotlin daemon 被 OOM 杀掉时会在工程根/模块根落这两个文件；
# 内容是内存转储说明，没有分析价值但会污染 git status）
hs_err_pid*.log
replay_pid*.log

# Kotlin 编译器的本地错误日志（.kotlin/errors/*.log）
.kotlin/
