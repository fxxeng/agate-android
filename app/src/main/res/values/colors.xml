<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 启动图标背景是独立品牌资产，不随主题切换 -->
    <color name="ic_launcher_background">#000000</color>

    <!-- 「跟随系统」档：这两项由 values-night 覆盖，preview 窗口按系统夜间模式取色 -->
    <color name="agate_bg">#F1F5F9</color>
    <color name="agate_chrome">#FEFEFE</color>

    <!-- 手动档必须引用固定色：否则「用户选浅色、系统却处于夜间」时
         preview 会从 values-night 取到纯黑，开机闪一下黑底。 -->
    <color name="agate_bg_light">#F1F5F9</color>
    <color name="agate_chrome_light">#FEFEFE</color>
    <color name="agate_bg_dark">#000000</color>
    <color name="agate_chrome_dark">#0A0A0C</color>
</resources>
